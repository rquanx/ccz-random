<Window x:Class="CczRandomizer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="曹操传随机工具 2.2" Height="760" Width="1260" MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI" FontSize="14" Background="{StaticResource PageBackground}">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="24,28,24,24">
                    <TextBlock Text="加强版 2.2" Foreground="White" FontSize="21" FontWeight="SemiBold" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="C# · WPF" Foreground="#64748B" FontSize="11" Margin="24,20,24,24" />
                <StackPanel Margin="14,0">
                    <Button Content="随机运行" Tag="run" Click="Navigate_Click" Style="{StaticResource NavButtonStyle}" />
                    <Button x:Name="RulesNavigation" Content="规则设置" Tag="rules" Click="Navigate_Click" Style="{StaticResource NavButtonStyle}" />
                    <Button Content="历史记录" Tag="history" Click="Navigate_Click" Style="{StaticResource NavButtonStyle}" />
                    <Button Content="常见问题" Tag="help" Click="Navigate_Click" Style="{StaticResource NavButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="42,34,42,34">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock x:Name="PageTitle" Text="随机运行" FontSize="30" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock x:Name="PageSubtitle" Text="按所选人物评分，合格后保存并读回验证。" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,8,0,24" />
            </StackPanel>
            <Border Grid.Row="1" Background="{StaticResource PanelBackground}" CornerRadius="18" Padding="28"><ContentControl x:Name="PageContent" /></Border>
        </Grid>
    </Grid>
</Window>
