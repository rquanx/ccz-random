<Window x:Class="CczRandomizer.Wpf.EquipmentWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="宝物信息" Width="900" Height="680" MinWidth="560" MinHeight="400" WindowStartupLocation="CenterOwner" Background="#F5F7FB">
 <DockPanel Margin="24">
  <TextBox x:Name="Search" DockPanel.Dock="Top" Padding="10" Margin="0,0,0,16" ToolTip="搜索宝物、效果或组合" TextChanged="SearchChanged" />
  <TextBlock x:Name="EmptyMessage" DockPanel.Dock="Bottom" Foreground="#64748B" Margin="0,12,0,0" />
  <ListBox x:Name="Cards" BorderThickness="0" Background="Transparent"
   ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate>
    <Border Background="White" BorderBrush="#D9E0EA" BorderThickness="1" CornerRadius="10" Margin="0,0,0,10" Padding="18">
     <StackPanel>
      <TextBlock Text="{Binding Category}" Foreground="#64748B" FontSize="12"/>
      <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,6"/>
      <TextBlock Text="{Binding Effect}" TextWrapping="Wrap" Margin="12,0,0,0"/>
     </StackPanel>
    </Border>
   </DataTemplate></ListBox.ItemTemplate>
  </ListBox>
 </DockPanel>
</Window>
