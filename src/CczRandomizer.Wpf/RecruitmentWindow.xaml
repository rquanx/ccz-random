<Window x:Class="CczRandomizer.Wpf.RecruitmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="入队人员" Width="980" Height="700" WindowStartupLocation="CenterOwner" Background="#F5F7FB">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,18">
            <TextBlock Text="入队人员" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBox x:Name="FilterBox" Width="240" Margin="28,0,0,0" Padding="8" VerticalContentAlignment="Center" TextChanged="FilterBox_TextChanged" />
            <TextBlock Text="筛选姓名、兵种或关卡" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="Cards" /></ScrollViewer>
    </DockPanel>
</Window>
