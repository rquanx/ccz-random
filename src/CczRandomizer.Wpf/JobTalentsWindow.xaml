<Window x:Class="CczRandomizer.Wpf.JobTalentsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="兵种天赋" Width="900" Height="680" MinWidth="560" MinHeight="400" WindowStartupLocation="CenterOwner" Background="#F5F7FB">
 <DockPanel Margin="24">
  <TextBox x:Name="Search" DockPanel.Dock="Top" Padding="10" Margin="0,0,0,16" ToolTip="搜索兵种或天赋" TextChanged="SearchChanged" />
  <ListBox x:Name="Cards" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListBox.ItemContainerStyle>
   <ListBox.ItemTemplate><DataTemplate><Border Background="White" BorderBrush="#D9E0EA" BorderThickness="1" CornerRadius="10" Margin="0,0,0,10" Padding="18">
    <StackPanel><TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="12,0,0,0"/>
    </StackPanel>
   </Border></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
 </DockPanel>
</Window>
