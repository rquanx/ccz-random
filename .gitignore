# Python environments and caches
/.venv*/
/__pycache__/
*.py[cod]

# Build and packaging output
/build*/
/dist*/
*.obj
*.lib
*.exp
/native/*.dll
/native/*.exe

# Runtime output
/ccz_fast_logs/
/ccz_fast_data/
/randResult/
/*.E5S
/random_rules.json
/.random_rules.json.*.tmp
/randomizer_settings.json

# Generated inspection and reverse-engineering workspaces
/inspect-*/
/coord-probe/
/current-check/
/memory-slots/
/offscreen-ui-test/
/r1-probe/
/renderer/
/renderer-preview*/
/sequence/
/skill-ground-truth/
/valid-templates/
/vendor/
/artifacts/
/release/

# Captures and generated reports
/*.png
/*.jpg
/*.bmp
/*.htm
/*.html
/*.txt

# Required packaged assets kept despite the capture rules above
!/resources/app/source_slot_20_help.png
!/resources/data/jobs/job_map.txt
.tmp/
